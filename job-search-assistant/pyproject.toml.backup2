[project]
name = "job-search-assistant"
version = "1.0.0"
description = "AI-powered job search assistant for enterprise sales positions"
authors = [
    {name = "Jack Agnew", email = "jack@clevelsalesguy.com"}
]
readme = "README.md"
requires-python = ">=3.11"

dependencies = [
    "agents>=0.1.0",
    "openai>=1.0.0",
    "pydantic>=2.0.0",
    "python-dotenv>=1.0.0",
    "sendgrid>=6.0.0",
    "asyncio",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0.0",
    "black>=23.0.0",
    "isort>=5.0.0",
    "mypy>=1.0.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.black]
line-length = 88
target-version = ['py311']

[tool.isort]
profile = "black"
line_length = 88

[tool.mypy]
python_version = "3.11"
warn_return_any = true
warn_unused_configs = true
