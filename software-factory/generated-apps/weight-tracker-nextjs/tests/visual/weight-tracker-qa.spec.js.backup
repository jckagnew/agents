const { chromium } = require('playwright');
const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

/**
 * Weight Tracker Visual QA Test Suite
 * Updated to test tab-based navigation instead of routes
 *
 * DESIGN VERSION GATE:
 * - Validates design version manifest before running tests
 * - Compares screenshots against baselines (TODO: not yet implemented)
 * - Blocks QA if design artifacts are invalid or missing
 */

/**
 * Check design version before running tests
 * Exits with code 1 if validation fails
 */
function checkDesignVersion() {
    console.log('🔍 Checking design version...');
    try {
        // Run design version validation script (at repo root)
        const scriptPath = path.resolve(__dirname, '../../../../../scripts/check-design-version.js');
        execSync(`node "${scriptPath}"`, {
            stdio: 'inherit', // Show output directly
            cwd: path.resolve(__dirname, '../../../../..')
        });
        console.log('✅ Design version validation passed\n');
    } catch (error) {
        console.error('\n❌ Design version validation FAILED');
        console.error('⛔ QA cannot proceed until design artifacts are valid');
        console.error('\nFix the issues above, then re-run visual tests.\n');
        process.exit(1);
    }
}

/**
 * Compare screenshot against baseline (STUB - not yet implemented)
 * @param {string} screenshotPath - Path to current test screenshot
 * @param {string} baselinePath - Path to baseline screenshot
 * @returns {Promise<{match: boolean, diff: string|null}>}
 */
async function compareWithBaseline(screenshotPath, baselinePath) {
    // TODO: Implement visual diff comparison
    // - Load both images using pixelmatch or similar
    // - Compute pixel differences
    // - Generate diff image highlighting changes
    // - Return match status and diff image path
    //
    // For now, always return true (no comparison)
    return {
        match: true,
        diff: null,
        reason: 'Baseline comparison not yet implemented'
    };
}

async function runWeightTrackerQA() {
    // DESIGN VERSION GATE: Check before running tests
    checkDesignVersion();

    console.log('🎨 Starting Weight Tracker Visual QA Review...');
    const startTime = Date.now();

    try {
        const launchOptions = { headless: true };
        const chromePath = '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';
        if (fs.existsSync(chromePath)) {
            launchOptions.executablePath = chromePath;
        }

        const browser = await chromium.launch(launchOptions);
        const context = await browser.newContext();

        // Pre-authenticate the user before any page loads so the dashboard shows up immediately
        await context.addInitScript((storedUser) => {
            window.localStorage.setItem(
                'weight-tracker-user',
                JSON.stringify({ ...storedUser, loginTime: Date.now() })
            );
        }, { id: 'qa_user', username: 'demo', emoji: '👤' });

        // Ensure screenshots directory exists
        const screenshotsDir = path.resolve(process.cwd(), 'screenshots');
        if (!fs.existsSync(screenshotsDir)) {
            fs.mkdirSync(screenshotsDir, { recursive: true });
        }

        // Test viewports (Desktop, Tablet, Mobile)
        const viewports = [
            { name: 'Desktop', width: 1440, height: 900 },
            { name: 'Tablet', width: 768, height: 1024 },
            { name: 'Mobile', width: 375, height: 667 }
        ];

        // Screens to test with their button selectors
        const screens = [
            { name: 'Dashboard', buttonText: null, key: 'dashboard', heading: 'Weight Tracker Pro' }, // Default screen
            { name: 'Log Entry', buttonText: 'Log', key: 'log', heading: 'Log New Entry' },
            { name: 'History', buttonText: 'History', key: 'history', heading: 'Weight History' },
            { name: 'Analytics', buttonText: 'Analytics', key: 'analytics', heading: 'Analytics' },
            { name: 'Settings', buttonText: 'Settings', key: 'settings', heading: 'Settings' }
        ];

        const results = {
            screens: [],
            screenshots: [],
            scores: {},
            issues: [],
            duration: 0
        };

        // Test each screen at each viewport
        for (const screen of screens) {
            console.log(`\n📱 Testing ${screen.name} screen...`);
            const screenResults = {
                name: screen.name,
                buttonText: screen.buttonText,
                viewports: []
            };

            for (const viewport of viewports) {
                console.log(`  ${viewport.name} (${viewport.width}x${viewport.height})`);

                const page = await context.newPage();
                await page.setViewportSize({ width: viewport.width, height: viewport.height });

                try {
                    // Navigate to home page
                    await page.goto('http://localhost:3000', {
                        waitUntil: 'networkidle',
                        timeout: 10000
                    });

                    // If not Dashboard, click the navigation button
                    if (screen.buttonText) {
                        await page.waitForTimeout(300);
                        const navLocator = page.locator('nav[aria-label="Main navigation"]');
                        await navLocator.first().waitFor({ timeout: 5000 });
                        const visibleNavButtons = page.locator('nav[aria-label="Main navigation"] button:visible');
                        const buttonLocator = visibleNavButtons.filter({ hasText: screen.buttonText });
                        const buttonCount = await buttonLocator.count();

                        if (buttonCount > 0) {
                            await buttonLocator.first().click();
                        } else {
                            console.log(`    ⚠️  Navigation button "${screen.buttonText}" not found; staying on current screen`);
                        }
                    }

                    const expectedLabel = screen.buttonText ?? 'Dashboard';
                    await page.waitForFunction((label) => {
                        const navButtons = Array.from(document.querySelectorAll('nav[aria-label="Main navigation"] button'));
                        return navButtons.some((btn) => {
                            const text = btn.textContent || '';
                            return text.includes(label) && btn.getAttribute('aria-current') === 'page';
                        });
                    }, expectedLabel);

                    if (screen.heading) {
                        await page.locator('h1', { hasText: screen.heading }).first().waitFor({ timeout: 5000 });
                    }

                    // Take screenshot
                    const screenshotFile = `${screen.key}-${viewport.name.toLowerCase()}-${viewport.width}x${viewport.height}.png`;
                    const screenshotPath = path.join('screenshots', screenshotFile);
                    await page.screenshot({
                        path: path.join(screenshotsDir, screenshotFile),
                        fullPage: true
                    });
                    results.screenshots.push(screenshotPath);

                    // Collect metrics
                    const metrics = await page.evaluate(() => {
                        // Helper to check if button text contains string
                        const hasButtonWithText = (text) => {
                            const buttons = Array.from(document.querySelectorAll('button'));
                            return buttons.some(btn => btn.textContent.includes(text));
                        };

                        return {
                            title: document.title,
                            hasH1: !!document.querySelector('h1'),
                            h1Text: document.querySelector('h1')?.textContent || '',
                            hasButtons: document.querySelectorAll('button').length,
                            hasCards: document.querySelectorAll('[class*="card"]').length,
                            hasPillButtons: document.querySelectorAll('[class*="button-"]').length,
                            hasNavigation: hasButtonWithText('Log') || hasButtonWithText('History') || hasButtonWithText('Analytics'),
                            errors: []
                        };
                    });

                    screenResults.viewports.push({
                        viewport: viewport.name,
                        dimensions: `${viewport.width}x${viewport.height}`,
                        screenshot: screenshotPath,
                        metrics,
                        success: true
                    });

                } catch (error) {
                    console.error(`    ❌ Error: ${error.message}`);
                    screenResults.viewports.push({
                        viewport: viewport.name,
                        dimensions: `${viewport.width}x${viewport.height}`,
                        error: error.message,
                        success: false
                    });
                }

                await page.close();
            }

            results.screens.push(screenResults);
        }

        await browser.close();

        // Calculate quality scores
        const scoring = calculateQualityScore(results);
        results.scores = scoring.scores;
        results.issues = scoring.issues;
        results.grade = scoring.grade;
        results.overallScore = scoring.overallScore;

        const endTime = Date.now();
        results.duration = (endTime - startTime) / 1000;

        // Generate report
        generateReport(results);

        return results;

    } catch (error) {
        console.error('❌ Critical Error during Visual QA:', error.message);
        return {
            success: false,
            error: error.message,
            duration: 0,
            overallScore: 0
        };
    }
}

function calculateQualityScore(results) {
    const scores = {
        brandCompliance: 0,      // 25 points
        responsiveDesign: 0,     // 20 points
        accessibility: 0,        // 25 points
        performance: 0,          // 15 points
        visualPolish: 0          // 15 points
    };
    const issues = [];

    // Brand Compliance (25 points)
    let successfulScreens = 0;
    results.screens.forEach(screen => {
        const hasAllViewports = screen.viewports.filter(v => v.success).length === 3;
        if (hasAllViewports) successfulScreens++;
    });
    scores.brandCompliance = Math.round((successfulScreens / results.screens.length) * 25);

    if (successfulScreens < results.screens.length) {
        issues.push(`${results.screens.length - successfulScreens} screen(s) failed to load in all viewports`);
    }

    // Responsive Design (20 points)
    const allViewportsWorking = results.screens.every(screen =>
        screen.viewports.every(v => v.success)
    );
    scores.responsiveDesign = allViewportsWorking ? 20 : 10;

    if (!allViewportsWorking) {
        issues.push('Not all screens are responsive across all viewports');
    }

    // Accessibility (25 points) - Check for H1 on each screen
    let screensWithH1 = 0;
    results.screens.forEach(screen => {
        const desktopView = screen.viewports.find(v => v.viewport === 'Desktop');
        if (desktopView?.metrics?.hasH1) screensWithH1++;
    });
    scores.accessibility = Math.round((screensWithH1 / results.screens.length) * 25);

    if (screensWithH1 < results.screens.length) {
        issues.push(`${results.screens.length - screensWithH1} screen(s) missing H1 heading`);
    }

    // Performance (15 points) - Based on successful loads
    const successfulLoads = results.screens.reduce((sum, screen) =>
        sum + screen.viewports.filter(v => v.success).length, 0
    );
    const totalTests = results.screens.length * 3;
    scores.performance = Math.round((successfulLoads / totalTests) * 15);

    // Visual Polish (15 points) - Check for buttons and PillButtons
    let screensWithInteractiveElements = 0;
    results.screens.forEach(screen => {
        const desktopView = screen.viewports.find(v => v.viewport === 'Desktop');
        const hasButtons = desktopView?.metrics?.hasButtons > 0;
        const hasPillButtons = desktopView?.metrics?.hasPillButtons > 0;
        if (hasButtons || hasPillButtons) screensWithInteractiveElements++;
    });
    scores.visualPolish = Math.round((screensWithInteractiveElements / results.screens.length) * 15);

    if (screensWithInteractiveElements < results.screens.length) {
        issues.push(`${results.screens.length - screensWithInteractiveElements} screen(s) missing interactive elements`);
    }

    // Calculate overall score
    const overallScore = Object.values(scores).reduce((sum, score) => sum + score, 0);

    // Assign grade
    let grade = 'F';
    if (overallScore >= 90) grade = 'A';
    else if (overallScore >= 80) grade = 'B';
    else if (overallScore >= 70) grade = 'C';
    else if (overallScore >= 60) grade = 'D';

    return { scores, issues, overallScore, grade };
}

function generateReport(results) {
    console.log('\n📊 Weight Tracker Visual QA Report');
    console.log('===================================');
    console.log(`Overall Score: ${results.overallScore}/100`);
    console.log(`Grade: ${results.grade}`);
    console.log(`Duration: ${results.duration.toFixed(2)}s`);
    console.log(`Screens Tested: ${results.screens.length}`);
    console.log(`Viewports: Desktop, Tablet, Mobile`);

    console.log('\n📈 Score Breakdown:');
    console.log(`  Brand Compliance:  ${results.scores.brandCompliance}/25`);
    console.log(`  Responsive Design: ${results.scores.responsiveDesign}/20`);
    console.log(`  Accessibility:     ${results.scores.accessibility}/25`);
    console.log(`  Performance:       ${results.scores.performance}/15`);
    console.log(`  Visual Polish:     ${results.scores.visualPolish}/15`);

    if (results.issues.length > 0) {
        console.log('\n🚨 Issues Found:');
        results.issues.forEach(issue => console.log(`  - ${issue}`));
    } else {
        console.log('\n✅ No critical issues found');
    }

    console.log('\n📱 Screen Results:');
    results.screens.forEach(screen => {
        const successCount = screen.viewports.filter(v => v.success).length;
        const status = successCount === 3 ? '✅' : '⚠️';
        const buttonInfo = screen.buttonText ? ` (nav: "${screen.buttonText}")` : ' (default)';
        console.log(`  ${status} ${screen.name}${buttonInfo}: ${successCount}/3 viewports passed`);
    });

    console.log('\n📸 Screenshots saved to screenshots/ directory');
    console.log(`📄 Total screenshots: ${results.screens.length * 3}`);

    // Save JSON report
    const reportPath = `reports/weight-tracker-qa-${new Date().toISOString().split('T')[0]}.json`;
    fs.writeFileSync(reportPath, JSON.stringify(results, null, 2));
    console.log(`\n💾 Full report saved to: ${reportPath}`);

    // Determine pass/fail
    const passed = results.overallScore >= 85;
    console.log(`\n🎯 Status: ${passed ? '✅ PASS' : '❌ FAIL'} (threshold: 85)`);

    if (!passed) {
        console.log('🔄 Iteration needed - score below 85 threshold');
    } else {
        console.log('🎉 Visual QA Success - Weight Tracker meets quality standards!');
    }
}

// Create directories if they don't exist
if (!fs.existsSync('screenshots')) fs.mkdirSync('screenshots', { recursive: true });
if (!fs.existsSync('reports')) fs.mkdirSync('reports', { recursive: true });

// Run the test
runWeightTrackerQA().then(result => {
    if (result.success === false) {
        console.log('\n❌ Test suite failed to complete');
        process.exit(1);
    } else if (result.overallScore < 85) {
        console.log('\n⚠️ Quality threshold not met - review issues above');
        process.exit(1);
    } else {
        console.log('\n✅ All quality checks passed!');
        process.exit(0);
    }
}).catch(error => {
    console.error('\n❌ Fatal error:', error);
    process.exit(1);
});
