# Local Environment Variables for Weight Tracker Testing
# Copy this file to .env.local and fill in the actual values

# =============================================================================
# ANALYTICS CONFIGURATION
# =============================================================================
# GA4 Measurement IDs for each DBA track (use neutral names until DBAs finalized)
NEXT_PUBLIC_GA4_CONSUMER_ID=G-XXXXXXXXX-1
NEXT_PUBLIC_GA4_BESPOKE_ID=G-XXXXXXXXX-2
NEXT_PUBLIC_GA4_ENTERPRISE_ID=G-XXXXXXXXX-3

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Supabase project URL and anonymous key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 1. Replace the placeholder values above with actual GA4 and Supabase credentials
# 2. The analytics utility will automatically map hostnames to the correct GA4 ID
# 3. The Supabase utility will use the same project for all brands (can be customized later)
# 4. For local development, the app defaults to the consumer track configuration
# 5. Test the hostname routing by accessing:
#    - http://localhost:3000 (defaults to consumer)
#    - Use browser dev tools to simulate different hostnames if needed
