# Environment Template for Software Factory Applications
# Copy this file to .env and fill in the required values
# DO NOT commit .env files to version control

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/software_factory
DATABASE_NAME=software_factory
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_BASE_URL=http://localhost:3000
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Name Vetting Services
# Domainr API - Domain availability and registration data
DOMAINR_API_KEY=your-domainr-api-key

# GoDaddy API - Domain availability (fallback)
GODADDY_API_KEY=your-godaddy-api-key
GODADDY_SECRET_KEY=your-godaddy-secret-key

# Google Custom Search API - Brand conflict detection
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_ENGINE_ID=your-google-search-engine-id

# USPTO TSDR API - Trademark search (no API key required)
# Note: USPTO API is free but implement rate limiting (1 request/second)

# Gemini API - AI-powered search and analysis
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# HuggingFace Configuration
HF_TOKEN=your-huggingface-token-here

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
FROM_EMAIL=noreply@softwarefactory.com

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE=logs/app.log

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
DEBUG=true
HOT_RELOAD=true
MOCK_EXTERNAL_SERVICES=false

# =============================================================================
# ANALYTICS & TRACKING CONFIGURATION
# =============================================================================
# Google Analytics 4 (GA4) Configuration
# Per-DBA analytics properties based on hostname routing
GA4_CONSUMER_ID=G-XXXXXXXXX-1
GA4_BESPOKE_ID=G-XXXXXXXXX-2  
GA4_ENTERPRISE_ID=G-XXXXXXXXX-3

# Default GA4 ID (fallback)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXX-0

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_DEBUG=false

# =============================================================================
# DBA-SPECIFIC CONFIGURATION
# =============================================================================
# Consumer-facing brand (placeholder until DBA finalized)
CONSUMER_BRAND_NAME=ConsumerTrack
CONSUMER_DOMAIN=consumer.clevelsalesguy.com
CONSUMER_GA4_ID=G-XXXXXXXXX-1

# Bespoke/White-label brand (placeholder)
BESPOKE_BRAND_NAME=BespokeTrack
BESPOKE_DOMAIN=bespoke.clevelsalesguy.com
BESPOKE_GA4_ID=G-XXXXXXXXX-2

# Enterprise brand (placeholder)
ENTERPRISE_BRAND_NAME=EnterpriseTrack
ENTERPRISE_DOMAIN=enterprise.clevelsalesguy.com
ENTERPRISE_GA4_ID=G-XXXXXXXXX-3

# NOTE: Update the placeholder track names/domains above once final DBA or
# joint-venture brands are selected. The shared Supabase configuration works
# across multiple ventures; introduce per-track credentials only if isolation
# is required.

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and modify these for production deployment
# NODE_ENV=production
# DEBUG=false
# HOT_RELOAD=false
# MOCK_EXTERNAL_SERVICES=false
# DATABASE_URL=postgresql://user:password@prod-db:5432/software_factory
# REDIS_URL=redis://prod-redis:6379
