{
  // =============================================================================
  // PRETTIER CONFIGURATION
  // =============================================================================
  // Comprehensive Prettier configuration for consistent code formatting
  // =============================================================================

  // =============================================================================
  // BASIC FORMATTING
  // =============================================================================
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,

  // =============================================================================
  // JAVASCRIPT/TYPESCRIPT SPECIFIC
  // =============================================================================
  "quoteProps": "as-needed",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "lf",

  // =============================================================================
  // HTML/JSX SPECIFIC
  // =============================================================================
  "htmlWhitespaceSensitivity": "css",
  "jsxSingleQuote": true,
  "jsxBracketSameLine": false,

  // =============================================================================
  // MARKDOWN SPECIFIC
  // =============================================================================
  "proseWrap": "preserve",

  // =============================================================================
  // OVERRIDE FOR SPECIFIC FILE TYPES
  // =============================================================================
  "overrides": [
    {
      "files": "*.json",
      "options": {
        "printWidth": 120,
        "tabWidth": 2
      }
    },
    {
      "files": "*.md",
      "options": {
        "printWidth": 100,
        "proseWrap": "always"
      }
    },
    {
      "files": "*.yaml",
      "options": {
        "printWidth": 120,
        "tabWidth": 2
      }
    },
    {
      "files": "*.yml",
      "options": {
        "printWidth": 120,
        "tabWidth": 2
      }
    }
  ]
}
