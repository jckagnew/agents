{
  "name": "project-starter",
  "version": "1.0.0",
  "description": "A comprehensive project starter template with all essential configurations and best practices",
  "main": "src/app.js",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "test": "./scripts/test.sh",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "./scripts/deploy.sh",
    "github": "./scripts/github.sh",
    "lint": "eslint src/ tests/ --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src/ tests/ --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "build": "npm run lint && npm run test && npm run build:prod",
    "build:prod": "echo 'Production build completed'",
    "start": "node src/app.js",
    "docker:build": "docker build -t project-starter .",
    "docker:run": "docker run -p 3000:3000 project-starter",
    "docker:dev": "docker-compose up --build",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "deps:update": "npm update",
    "deps:check": "npm outdated",
    "clean": "rm -rf node_modules dist build coverage .nyc_output",
    "precommit": "npm run lint && npm run test",
    "prepare": "husky install"
  },
  "keywords": [
    "project-starter",
    "template",
    "boilerplate",
    "development",
    "best-practices"
  ],
  "author": "Jack Agnew",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "openai": "^5.9.1",
    "resend": "^4.6.0",
    "rss-parser": "^3.13.0",
    "@supabase/supabase-js": "^2.51.0",
    "next": "^15.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next-auth": "^4.24.11",
    "@auth/supabase-adapter": "^1.10.0",
    "jose": "^6.0.11",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "@playwright/test": "^1.54.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jest-environment-jsdom": "^30.0.4",
    "ts-jest": "^29.4.0",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4",
    "eslint-config-next": "15.3.5",
    "identity-obj-proxy": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{js,jsx,ts,tsx}",
      "!src/**/*.spec.{js,jsx,ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "no-console": "warn",
      "no-unused-vars": "error",
      "no-undef": "error"
    },
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jckagnew/project-starter.git"
  },
  "bugs": {
    "url": "https://github.com/jckagnew/project-starter/issues"
  },
  "homepage": "https://github.com/jckagnew/project-starter#readme"
}
