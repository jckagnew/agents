  "component_library": [
    {
      "component_name": "PillButton",
      "type": "button",
      "purpose": "Primary call-to-action button for key flows",
      "variants": ["primary", "secondary", "ghost"],
      "states": ["default", "hover", "active", "disabled"],
      "accessibility_requirements": ["Minimum 4.5:1 contrast", "Keyboard focus outline", "ARIA label for icon-only variant"],
      "responsive_behavior": "Full-width on mobile, intrinsic width on tablet and desktop"
    },
    {
      "component_name": "StatCard",
      "type": "card",
      "purpose": "Display key metrics such as current weight and body-fat delta",
      "variants": ["default", "trend-up", "trend-down"],
      "states": ["loading", "empty", "populated"],
      "accessibility_requirements": ["Announce metric and delta via aria-live", "Provide textual trend description"],
      "responsive_behavior": "Stack vertically on mobile, three-column grid on desktop"
    },
    {
      "component_name": "TrendChart",
      "type": "data-display",
      "purpose": "Render weight and body fat trends over adjustable periods",
      "variants": ["line", "area"],
      "states": ["loading", "empty", "populated", "error"],
      "accessibility_requirements": ["Provide tabular fallback", "Ensure color and marker differentiation"],
      "responsive_behavior": "Adaptive height with tooltip repositioning on smaller screens"
    },
    {
      "component_name": "ProgressBar",
      "type": "data-display",
      "purpose": "Show goal progress as percentage",
      "variants": ["standard", "success", "warning"],
      "states": ["default", "indeterminate"],
      "accessibility_requirements": ["aria-valuenow/aria-valuemin/aria-valuemax attributes", "Visible label for percentage"],
      "responsive_behavior": "Full-width with label alignment adjustments across breakpoints"
    },
    {
      "component_name": "NavigationBar",
      "type": "navigation",
      "purpose": "Primary navigation across dashboard sections",
      "variants": ["top", "side", "mobile-bottom"],
      "states": ["default", "active", "hover"],
      "accessibility_requirements": ["Keyboard arrow navigation", "aria-current for active page"],
      "responsive_behavior": "Collapses to bottom navigation on mobile and sidebar on desktop"
    },
    {
      "component_name": "DataTable",
      "type": "data-display",
      "purpose": "List historical weight entries with filters and sorting",
      "variants": ["default", "dense"],
      "states": ["loading", "empty", "populated", "error"],
      "accessibility_requirements": ["Table headers with scope", "Keyboard accessible filters"],
      "responsive_behavior": "Horizontal scroll with sticky headers on mobile"
    },
    {
      "component_name": "LogEntryForm",
      "type": "input",
      "purpose": "Capture daily weight, body fat, notes, and habits",
      "variants": ["modal", "inline"],
      "states": ["default", "submitting", "success", "error"],
      "accessibility_requirements": ["Field labels associated with inputs", "Error messages programmatically tied to fields"],
      "responsive_behavior": "Single column on mobile, two-column grouping on desktop"
    },
    {
      "component_name": "NotificationToast",
      "type": "data-display",
      "purpose": "Provide contextual feedback for actions",
      "variants": ["success", "warning", "error", "info"],
      "states": ["visible", "dismissed"],
      "accessibility_requirements": ["aria-live=polite", "Dismiss button accessible via keyboard"],
      "responsive_behavior": "Anchored bottom on mobile and top-right on desktop"
    }
  ],
