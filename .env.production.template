# ===================================================================
# Design-First Software Factory - Production Environment Template
# ===================================================================
# Copy this file to .env.production and fill in your actual values
# NEVER commit .env.production to git!
# ===================================================================

# === BACKEND CONFIGURATION (for Railway deployment) ===

# Server
NODE_ENV=production
PORT=3000

# Supabase (Backend - use SERVICE ROLE KEY, not anon key!)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (Job Queue)
# Option A: Upstash
REDIS_URL=redis://default:password@your-endpoint.upstash.io:6379

# Option B: Redis Cloud
# REDIS_URL=redis://default:password@redis-12345.c123.us-east-1-1.ec2.cloud.redislabs.com:12345

# Option C: Railway Redis (automatically provided)
# REDIS_URL is set automatically by Railway if you add the Redis service

# AI Service API Keys
OPENAI_API_KEY=sk-proj-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here
GOOGLE_AI_API_KEY=AIzaYourKeyHere

# Optional: AI Model Configuration
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_MODEL=claude-3-5-sonnet-20250219
GOOGLE_AI_MODEL=gemini-pro

# Optional: Job Queue Configuration
BULL_CONCURRENCY=5
BULL_MAX_RETRIES=3

# CORS Configuration
# Update this after deploying frontend to Vercel
ALLOWED_ORIGINS=http://localhost:19006,https://your-factory-domain.vercel.app

# === FRONTEND CONFIGURATION (for Vercel deployment) ===

# Backend API URLs (set these in Vercel dashboard)
# EXPO_PUBLIC_API_URL=https://your-railway-app.up.railway.app
# EXPO_PUBLIC_WS_URL=wss://your-railway-app.up.railway.app

# Supabase (Frontend - use ANON KEY, not service role!)
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===================================================================
# DEPLOYMENT CHECKLIST:
# ===================================================================
# [ ] Create Supabase project and get credentials
# [ ] Provision Redis instance (Upstash/Redis Cloud/Railway)
# [ ] Get AI API keys (OpenAI, Anthropic, Google)
# [ ] Deploy backend to Railway with these variables
# [ ] Deploy frontend to Vercel with frontend variables
# [ ] Update ALLOWED_ORIGINS after frontend deployment
# [ ] Test health endpoint
# [ ] Test WebSocket connection
# [ ] Run end-to-end workflow test
# ===================================================================
