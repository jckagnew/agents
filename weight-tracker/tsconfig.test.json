{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./.test-dist",
    "rootDir": "..",
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "../factory/**/*.ts",
    "../design-system/**/*.ts"
  ],
  "exclude": [
    "src/__tests__",
    "src/components",
    "src/screens"
  ]
}
