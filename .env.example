# ===================================================================
# MASTER ENVIRONMENT CONFIGURATION
# Design-First Software Factory Monorepo
# ===================================================================
# 🎯 SINGLE SOURCE OF TRUTH FOR ALL PROJECTS
#
# This ONE .env file is used by:
#   ✓ Factory (apps/factory/)
#   ✓ Admin Console (apps/admin-console/)
#   ✓ All deployment scripts
#   ✓ All AI agents (Claude, Cursor, Codex, Gemini)
#
# 📋 Setup Instructions:
#   1. Copy this file: cp .env.example .env
#   2. Fill in real credentials (see comments below)
#   3. DONE! All apps will inherit these values
#
# 🔒 Security: .env is gitignored - never commit real credentials!
# ===================================================================
# EXISTING INFRASTRUCTURE: This project uses the existing Supabase
# project "design-factory-admin" - DO NOT create a new project!
# ===================================================================

# === SUPABASE CONFIGURATION (EXISTING PROJECT) ===
# Project Reference: design-factory-admin
# Region: us-east-1
# Dashboard: https://supabase.com/dashboard/project/design-factory-admin

# Supabase URL (get from: Settings > API)
SUPABASE_URL=https://design-factory-admin.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://design-factory-admin.supabase.co

# Supabase Anon Key (get from: Settings > API > Project API keys > anon public)
# This is safe to expose in frontend
SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (get from: Settings > API > Project API keys > service_role)
# ⚠️ KEEP THIS SECRET - only for backend/server use!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Edge Function JWT Secret (get from: Settings > API > JWT Settings)
EDGE_FUNCTION_JWT_SECRET=your-jwt-secret-here

# === BACKEND API CONFIGURATION ===
# Once backend is deployed, update these URLs

# Backend API URL (Railway/Render deployment)
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000

# Production URLs (update after deployment)
# EXPO_PUBLIC_API_URL=https://design-factory-api.up.railway.app
# EXPO_PUBLIC_WS_URL=wss://design-factory-api.up.railway.app

# === REDIS CONFIGURATION ===
# Choose ONE option:

# Option A: Upstash (Serverless Redis)
# REDIS_URL=redis://default:password@your-endpoint.upstash.io:6379

# Option B: Redis Cloud
# REDIS_URL=redis://default:password@redis-12345.c123.us-east-1-1.ec2.cloud.redislabs.com:12345

# Option C: Railway Redis (automatically provided when you add Redis service)
# REDIS_URL=redis://default:password@containers-us-west-XXX.railway.app:XXXX

# Local Development
REDIS_URL=redis://localhost:6379

# === AI SERVICES API KEYS ===

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-key-here

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google AI API Key (https://makersuite.google.com/app/apikey)
GOOGLE_AI_API_KEY=AIza-your-key-here
GEMINI_API_KEY=AIza-your-key-here

# === AI MODEL CONFIGURATION (Optional) ===
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_MODEL=claude-3-5-sonnet-20250219
GOOGLE_AI_MODEL=gemini-pro

# === STRIPE CONFIGURATION (for payments) ===

# Stripe Secret Key (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your-key-here

# Stripe Webhook Secret (https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# === FILE UPLOAD CONFIGURATION ===
# Used for signing upload URLs
FILE_UPLOAD_SIGNING_SECRET=your-signing-secret-here

# === JOB QUEUE CONFIGURATION ===
BULL_CONCURRENCY=5
BULL_MAX_RETRIES=3

# === CORS CONFIGURATION ===
# Update after deploying frontend
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:3000

# Production CORS (update after deployment)
# ALLOWED_ORIGINS=https://factory.yourdomain.com,https://admin.yourdomain.com

# === ENVIRONMENT ===
NODE_ENV=development
PORT=3000

# ===================================================================
# DEPLOYMENT CHECKLIST:
# ===================================================================
# [ ] Get credentials from existing Supabase project "design-factory-admin"
# [ ] Link to Supabase: supabase link --project-ref design-factory-admin
# [ ] Deploy Edge Functions: supabase functions deploy admin-customers --no-verify-jwt
# [ ] Provision Redis (Upstash/Redis Cloud/Railway)
# [ ] Get AI API keys (OpenAI, Anthropic, Google)
# [ ] Get Stripe keys (if using payments)
# [ ] Deploy backend to Railway/Render
# [ ] Update EXPO_PUBLIC_API_URL after backend deployment
# [ ] Deploy frontend to Vercel
# [ ] Update ALLOWED_ORIGINS after frontend deployment
# ===================================================================

# ===================================================================
# EXISTING DATABASE SCHEMA:
# ===================================================================
# Tables already exist in design-factory-admin:
# - admin_users (roles: owner, manager, support)
# - customers (tiers: starter, growth, enterprise)
# - projects (status: intake, in_review, in_progress, awaiting_client, delivered, archived)
# - project_notes (author types: admin, customer)
# - invoices (status: draft, sent, partial, paid, void)
#
# Storage Buckets:
# - designs
# - deliverables
# - avatars
# ===================================================================
